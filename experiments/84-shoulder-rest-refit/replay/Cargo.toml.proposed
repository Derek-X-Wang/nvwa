# Proposal only. Root owns manifest/lock integration and build scheduling.
[package]
name = "nvwa-shoulder-rest-replay"
version = "0.0.0"
edition = "2024"
publish = false
[workspace]
[[bin]]
name = "nvwa-shoulder-rest-replay"
path = "main.rs"
[dependencies]
nvwa-core = { path = "../../../crates/nvwa-core" }
nvwa-runtime = { path = "../../../crates/nvwa-runtime" }
serde_json = "1.0"
bevy = { version = "=0.19.1", default-features = false, features = ["std", "async_executor", "reflect_auto_register", "bevy_asset", "bevy_scene", "bevy_world_serialization", "bevy_gltf", "bevy_animation", "bevy_render", "bevy_core_pipeline", "bevy_pbr", "bevy_light", "bevy_camera", "bevy_mesh", "bevy_image", "bevy_shader", "bevy_window", "bevy_winit", "bevy_log", "bevy_color", "bevy_material", "png", "webgpu", "morph", "morph_animation", "gltf_animation", "multi_threaded", "keyboard", "mouse", "touch"] }
[patch.crates-io]
bevy_obj = { path = "../../../vendor/bevy_obj" }
wobj = { path = "../../../vendor/wobj" }
[profile.dev]
debug = 0
opt-level = 1
[profile.dev.package."*"]
opt-level = 1
