+
+/// Same core algorithms as the folder loader, with explicit typed target paths.
+/// Suitable for HTTP assets: no load_folder request is made by this route.
+pub fn load_and_insert_humentity_assets_explicit(
+    commands: &mut Commands,
+    asset_server: &AssetServer,
+    base_mesh_path: impl Into<AssetPath<'static>>,
+    vertex_groups_path: impl Into<AssetPath<'static>>,
+    target_composites_path: impl Into<AssetPath<'static>>,
+    target_macros_path: impl Into<AssetPath<'static>>,
+    target_paths: Vec<String>,
+    rig_config_path: impl Into<AssetPath<'static>>,
+    rig_weights_path: impl Into<AssetPath<'static>>,
+) {
+    commands.insert_resource(basemesh::BaseMesh::new(asset_server, base_mesh_path));
+    commands.insert_resource(basemesh::VertexGroups::new(asset_server, vertex_groups_path));
+    commands.insert_resource(morphs::MakeHumanMorphs::new_explicit(
+        asset_server, target_composites_path, target_macros_path, target_paths,
+    ));
+    commands.insert_resource(RigAssetHandles {
+        config: asset_server.load(rig_config_path),
+        weights: asset_server.load(rig_weights_path),
     });
 }
 
