+    /// Explicit typed target paths for HTTP/Wasm, where directory listing is unavailable.
+    /// An omitted target remains absent and compute_target_weights returns TargetNotFound.
+    pub fn new_explicit(
+        asset_server: &AssetServer,
+        composite_path: impl Into<AssetPath<'static>>,
+        macro_path: impl Into<AssetPath<'static>>,
+        target_paths: Vec<String>,
+    ) -> Self {
+        assert!(!target_paths.is_empty(), "explicit target list must not be empty");
+        Self {
+            targets: default(), macros: default(), composites: default(), categories: default(),
+            composite_handle: asset_server.load(composite_path),
+            macro_handle: asset_server.load(macro_path),
+            targets_handle: None,
+            explicit_targets: target_paths.into_iter().map(|path| asset_server.load(path)).collect(),
         }
     }
 
